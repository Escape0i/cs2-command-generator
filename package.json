{
  "name": "cs2-command-generator",
  "version": "1.0.0",
  "description": "CS2 practice room console command generator",
  "main": "main.js",
  "author": "Escape",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.escape.cs2commandgenerator",
    "productName": "CS2CommandGenerator",
    "asar": true,
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "CS2-Command-Generator-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
